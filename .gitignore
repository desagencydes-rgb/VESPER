__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
.DS_Store
Thumbs.db

# Runtime-owned, never governed (SPEC-26: no file is both).
/state/
/workspace/
/artifacts/
/backups/
/telemetry-store/

# Never commit secrets. SPEC-27 requires a dedicated mechanism.
*.pem
*.key
.env
.env.*

# SQLite sidecars are transient. An evidence store committed under
# docs/planning/spike-results/ must be a WAL-CONSOLIDATED SNAPSHOT
# (con.backup / .backup), never a live store plus its sidecars: SPIKE-008
# lost 300 committed rows copying a store that had an open writer.
*.db-shm
*.db-wal

# Prototype alarm run state: live, per-run, not evidence.
/.alarm-state/

# Self-signed TLS material for tools/spike/serve_camera_audit.py. Regenerated
# on demand; a private key must never be committed.
tools/spike/_certs/

# Session-local permission grants. Machine-specific and often stale;
# the shared allowlist is .claude/settings.json, which is tracked.
.claude/settings.local.json
graphify-out/
